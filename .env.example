# Supabase (fas 1 – app)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (fas 2 – upsert/rescore scripts only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM rescore (scripts/rescore_blocks.py)
GEMINI_API_KEY=...
# Optional: GEMINI_MODEL=gemini-2.5-flash-lite

# Matomo (self-hosted via docker compose, port 3251)
# Public URL that browsers hit (nginx → :3251). Empty = no tracking.
PUBLIC_MATOMO_URL=https://matomo.example.com
PUBLIC_MATOMO_SITE_ID=1
# Send hits from `npm run dev` (off by default so local traffic stays out of reports)
# PUBLIC_MATOMO_TRACK_DEV=true

# MariaDB for Matomo (required for `docker compose up`, never expose to the client)
MATOMO_DB_ROOT_PASSWORD=generate-a-strong-password
MATOMO_DB_PASSWORD=generate-a-strong-password
